@import "../colors/matugen.rasi"
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    south;
    anchor:                      south;
    fullscreen:                  false;
    width:                       600px;
    height:                      800px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    enabled:                     true;
    border-radius:               30px 30px 0px 0px;
    cursor:                      "default";
    background-color:            @surface-bright;
}
mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    orientation:                 vertical;
    height:                      800px;
    children:                    ["textbox-custom","inputbar","listbox"];
}
textbox-custom {
  expand: false;
  content: "";
  font: "Google Sans Flex 3";
  margin: 20 280 10 280;
  border-radius: 20;
  background-color: #ffffff66;
}
listbox {
    spacing:                     20px;
    padding:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}
/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    margin:                      10px 40px;
    spacing:                     10px;
    padding:                     10px 15px;
    border-radius:               30px;
    background-color:            @surface;
    text-color:                  @on-surface;
    children:                    ["textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         " ";
    font:                        "Google Sans Flex 20";
    vertical-align: 0.5;
	  horizontal-align: 0.5;
    background-color:            transparent;
    text-color:                  @primary;
    margin: 0;
}
entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      text;
    placeholder:                 "Buscar";
    placeholder-color:           @on-surface;
    vertical-align: 0.5;
}
/*****----- Mode Switcher -----*****/
mode-switcher{
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @on-primary;
}
button {
    padding:                     15px;
    border-radius:               10px;
    margin: 10px;
    background-color:            @surface;
    text-color:                  @on-surface;
    cursor:                      pointer;
}
button selected {
    background-color:            @primary;
    text-color:                  @on-primary;
}
/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     10px;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      "default";
}
/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     15px;
    padding:                     8px;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      pointer;
    orientation:                 vertical;
}
element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}
element normal.urgent {
    background-color:            @error;
    text-color:                  @on-error;
}
element normal.active {
    background-color:            @tertiary;
    text-color:                  @on-tertiary;
}
element selected.normal {
    background-color:            @surface;
    text-color:                  @primary;
}
element selected.urgent {
    background-color:            @error;
    text-color:                  @on-error;
}
element selected.active {
    background-color:            @primary;
    text-color:                  @on-secondary;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        32px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    horizontal-align:            0.5;
    font:                        "Google Sans Flex 11";
}

/*****----- Message -----*****/
message {
    background-color:            transparent;
}
textbox {
    padding:                     15px;
    border-radius:               10px;
    background-color:            @surface-container;
    text-color:                  @on-surface;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
error-message {
    padding:                     15px;
    border-radius:               20px;
    background-color:            @error;
    text-color:                  @on-error;
}
